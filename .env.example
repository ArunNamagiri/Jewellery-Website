# Copy this file to .env and fill in real values before running in Docker
# or production. Never commit your actual .env file.

# --- Flask ---
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- MySQL ---
DB_HOST=db
DB_PORT=3306
DB_USER=jewellery_user
DB_PASSWORD=jewellery_pass
DB_NAME=jewellery_store
MYSQL_ROOT_PASSWORD=change-this-root-password

# --- Admin panel login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-going-live

# --- Optional: local Ollama for AI recommendations ---
# Leave as default if you're not using this feature; the site works
# fine without Ollama running, it just skips the AI picks section.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2



# Add your GoldAPI token here to enable live network fetching:
GOLD_API_KEY=goldapi-570f370b92aca0e7eef746b9972be523-io
SECRET_KEY=secret-key-phrase
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jewellery_user
DB_PASSWORD=jewellery_pass
DB_NAME=jewellery_store